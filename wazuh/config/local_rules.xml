<!--
  Custom Wazuh rules covering the three attack scenarios in attacks/, plus one false positive
  suppression. Local IDs (100xxx range, the Wazuh convention for user-defined rules).

  These are bound to the "windows" group rather than the Sysmon event groups, because the
  sysmon_event_13 group is never assigned by this Wazuh version, which silently disables the
  built-in rules that depend on it. Field names and structure were taken from real Sysmon events
  captured on the host. See docs/decisions.md.
-->
<group name="local,soc_triage_demo,">

  <rule id="100001" level="12">
    <if_group>windows</if_group>
    <field name="win.system.channel">^Microsoft-Windows-Sysmon/Operational$</field>
    <field name="win.system.eventID">^1$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)powershell\.exe.*-(enc|encodedcommand)\b</field>
    <description>T1059.001 - Base64-encoded PowerShell command execution</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
  </rule>

  <rule id="100002" level="12">
    <if_group>windows</if_group>
    <field name="win.system.channel">^Microsoft-Windows-Sysmon/Operational$</field>
    <field name="win.system.eventID">^1$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)schtasks\.exe.*\/create</field>
    <description>T1053.005 - Scheduled task created (possible persistence)</description>
    <mitre>
      <id>T1053.005</id>
    </mitre>
  </rule>

  <!-- False positive suppression. Built-in rule 92213 ("Executable file dropped in folder commonly
       used by malware", level 15) fires on the __PSScriptPolicyTest_*.ps1 files PowerShell itself
       writes to %TEMP% to check the execution policy, on every script launch. Without this, running
       any legitimate script raises a level 15 alert and wakes the triage agent for nothing.
       Level 0 means the event is still logged, just not alerted on. -->
  <rule id="100010" level="0">
    <if_sid>92213</if_sid>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)\\__PSScriptPolicyTest_[a-z0-9]+\.[a-z0-9]+\.ps1$</field>
    <description>Suppressed false positive: PowerShell execution policy test file</description>
  </rule>

  <!-- Same rule, different noise source: Windows servicing (DISM) extracts its provider DLLs into
       a GUID-named subfolder under %TEMP% during normal update/maintenance operations, which also
       matches "executable dropped in a folder commonly used by malware". This is routine Windows
       background activity, unrelated to anything simulated in attacks/. -->
  <rule id="100011" level="0">
    <if_sid>92213</if_sid>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)\\Temp\\\{[0-9A-F-]+\}\\</field>
    <description>Suppressed false positive: Windows servicing (DISM) temp extraction</description>
  </rule>

  <!-- Escaping note: Wazuh stores Windows paths in targetObject with doubled backslashes, so a
       regex written with \\ (one literal backslash) never matches. It needs \\\\ (two literal
       backslashes). The official ruleset follows the same convention, see built-in rule 92300 in
       0860-sysmon_id_13.xml. -->
  <rule id="100003" level="12">
    <if_group>windows</if_group>
    <field name="win.system.channel">^Microsoft-Windows-Sysmon/Operational$</field>
    <field name="win.system.eventID">^13$</field>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)\\\\CurrentVersion\\\\Run\\\\</field>
    <description>T1547.001 - Registry Run key persistence value written</description>
    <mitre>
      <id>T1547.001</id>
    </mitre>
  </rule>

</group>
