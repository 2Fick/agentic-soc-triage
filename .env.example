# Copier ce fichier en `.env` (déjà dans .gitignore, jamais commit) et coller les clés telles
# quelles, sans guillemets : VT_API_KEY=abcd1234, pas VT_API_KEY="abcd1234".

# VirusTotal, palier gratuit : https://www.virustotal.com/gui/my-apikey
VT_API_KEY=

# AbuseIPDB, palier gratuit : https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# Gemini, palier gratuit, clé dédiée à ce projet (nouveau projet Google, quota indépendant)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Webhook entrant Slack (canal où le triage poste ses verdicts)
# https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=
