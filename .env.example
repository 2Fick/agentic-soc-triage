# Copy this file to `.env` (already gitignored, never committed) and paste the keys as they are,
# without quotes: VT_API_KEY=abcd1234, not VT_API_KEY="abcd1234".

# VirusTotal, free tier: https://www.virustotal.com/gui/my-apikey
VT_API_KEY=

# AbuseIPDB, free tier: https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# Gemini, free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Slack incoming webhook, for the channel that receives the verdicts
# https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=
